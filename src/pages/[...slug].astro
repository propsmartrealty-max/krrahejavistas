---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs';
import DynamicGallery from '@/components/ui/DynamicGallery';
import AeoFaqBlock from '@/components/seo/AeoFaqBlock';
import InternalLinkingGrid from '@/components/seo/InternalLinkingGrid';
import { synthesizeSeoContent } from '@/lib/seo/content-synthesizer';
import seoDatabase from '@/data/seo-database.json';

export function getStaticPaths() {
  const db = seoDatabase as Record<string, { title: string; description: string; h1: string; category: string; slug: string; content?: string | null }>;
  const allKeys = Object.keys(db);
  
  // Prioritize high-intent clusters: brand, comparison, blog, configuration, luxury, Pune_Real_Estate
  const priorityKeys = allKeys.filter(k => {
    const cat = db[k]?.category;
    return cat === 'brand' || cat === 'comparison' || cat === 'blog' || cat === 'luxury' || cat === 'configuration' || cat === 'Pune_Real_Estate';
  });
  
  // Add first 100 location & investment to cover top organic searches
  const otherKeys = allKeys.filter(k => !priorityKeys.includes(k)).slice(0, 100);
  const selectedKeys = Array.from(new Set([...priorityKeys, ...otherKeys]));

  return selectedKeys.map((slugKey) => ({
    params: { slug: slugKey },
    props: { data: db[slugKey], slugKey },
  }));
}

const { data, slugKey } = Astro.props;

const isArticle = data.category === 'blog';
const pillarMap: Record<string, string> = {
  'location': '/location/baner-annexe-pune',
  'configurations': '/configurations/luxury-apartments-mahalunge',
  'lifestyle': '/lifestyle/ultra-luxury-living-pune',
  'investment': '/investment/real-estate-investment-baner-annexe',
  'compare': '/compare/best-projects-in-mahalunge'
};

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: data.category.replace('_', ' '), href: pillarMap[data.category] || '/directory' },
  { label: data.h1, href: `/${slugKey}` }
];

const synthesized = synthesizeSeoContent(slugKey, data.h1, data.category);

const schemas = [
  synthesized.schemas.realEstateListing,
  synthesized.schemas.faqPage,
  synthesized.schemas.breadcrumbs,
  synthesized.schemas.product,
  synthesized.schemas.article,
].filter(Boolean) as Record<string, any>[];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={`https://www.krahejacorpvistas.com/${slugKey}`}
  schemas={schemas}
  article={isArticle}
>
  <div class="bg-[var(--color-luxury-charcoal)] min-h-screen">
    
    {/* Cinematic Hero Header */}
    <div class="relative h-[70vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <video
          autoplay
          loop
          muted
          playsinline
          preload="none"
          poster="/assets/living_room.jpg"
          class="w-full h-full object-cover opacity-40 scale-105"
        >
          <source src="/assets/video.mp4" type="video/mp4" />
          <img
            src="/assets/living_room.jpg"
            alt={`Luxury Living at K Raheja Vistas — ${data.h1}`}
            class="w-full h-full object-cover"
          />
        </video>
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-[var(--color-luxury-charcoal)]"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center mt-20">
        <span class="text-[var(--color-luxury-gold)] tracking-[0.4em] uppercase text-xs md:text-sm font-semibold mb-6 block drop-shadow-2xl">
          {isArticle ? 'RESEARCH & INSIGHTS' : data.category.replace('_', ' ').toUpperCase()}
        </span>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif text-[var(--color-luxury-pearl)] mb-6 leading-[1.1] drop-shadow-2xl font-light max-w-5xl mx-auto">
          {data.h1}
        </h1>
      </div>
    </div>

    <div class="container mx-auto px-6 relative z-10 -mt-20">
      
      <Breadcrumbs items={breadcrumbItems} client:idle />

      <div class="max-w-5xl mx-auto bg-black/40 backdrop-blur-md p-8 md:p-14 rounded-2xl border border-white/10 shadow-2xl">
        
        {!isArticle ? (
          <div>
            {data.content ? (
              <div 
                class="mb-12 prose prose-invert max-w-none prose-p:text-lg prose-p:text-white/80 prose-headings:font-serif prose-headings:font-light text-left"
                set:html={data.content} 
              />
            ) : (
              <div 
                class="mb-12 text-left"
                set:html={synthesized.overviewHtml}
              />
            )}

            {/* Specifications Matrix */}
            <div class="my-12 text-left">
              <div class="flex items-center justify-between mb-6 pb-3 border-b border-white/10">
                <div>
                  <h3 class="text-2xl font-serif text-[var(--color-luxury-pearl)]">
                    Architectural & Technical Specifications
                  </h3>
                  <p class="text-xs uppercase tracking-widest text-[var(--color-luxury-gold)] mt-1">
                    K Raheja Vistas Mahalunge — Benchmark Quality Standards
                  </p>
                </div>
                <span class="hidden md:inline-block px-3 py-1 bg-white/5 border border-white/10 rounded-full text-xs text-white/70">
                  MahaRERA: PR1260002501530
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {synthesized.specsTable.map((spec) => (
                  <div class="p-4 rounded-xl bg-white/[0.03] border border-white/5 hover:border-white/15 transition-colors">
                    <div class="text-xs uppercase tracking-wider text-white/50 mb-1">{spec.label}</div>
                    <div class="text-sm font-medium text-white/90">{spec.value}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* Hyperlocal Commute Radar */}
            <div class="my-12 text-left">
              <div class="mb-6 pb-3 border-b border-white/10">
                <h3 class="text-2xl font-serif text-[var(--color-luxury-pearl)]">
                  Micro-Market Commute & Connectivity Radar
                </h3>
                <p class="text-xs uppercase tracking-widest text-[var(--color-luxury-gold)] mt-1">
                  Signal-Free Transit from Mahalunge & Baner Annexe
                </p>
              </div>

              <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-white/80 border-collapse">
                  <thead>
                    <tr class="border-b border-white/10 text-xs uppercase tracking-wider text-[var(--color-luxury-gold)]">
                      <th class="py-3 px-4">Key Hub / Landmark</th>
                      <th class="py-3 px-4">Distance</th>
                      <th class="py-3 px-4">Travel Time</th>
                      <th class="py-3 px-4">Strategic Value</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5">
                    {synthesized.commuteRadar.map((commute) => (
                      <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="py-3 px-4 font-medium text-white">{commute.destination}</td>
                        <td class="py-3 px-4 text-[var(--color-luxury-gold)]">{commute.distance}</td>
                        <td class="py-3 px-4">{commute.travelTime}</td>
                        <td class="py-3 px-4 text-white/60 text-xs">{commute.highlight}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Financial & Investment Highlights */}
            <div class="my-12 text-left">
              <div class="mb-6 pb-3 border-b border-white/10">
                <h3 class="text-2xl font-serif text-[var(--color-luxury-pearl)]">
                  Estimated Financial & Investment Framework (2026)
                </h3>
                <p class="text-xs uppercase tracking-widest text-[var(--color-luxury-gold)] mt-1">
                  West Pune Real Estate Capital & Rental Appreciation
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {synthesized.financialMatrix.map((fin) => (
                  <div class="p-5 rounded-xl bg-white/[0.03] border border-white/10 flex flex-col justify-between">
                    <div>
                      <div class="text-xs uppercase tracking-wider text-white/50 mb-2">{fin.item}</div>
                      <div class="text-xl font-serif text-[var(--color-luxury-gold)] font-bold">{fin.value}</div>
                    </div>
                    <div class="text-xs text-white/60 mt-3 pt-3 border-t border-white/5">{fin.note}</div>
                  </div>
                ))}
              </div>
            </div>
            
            <DynamicGallery slug={slugKey} title={data.h1} client:visible />
            
            <div class="flex flex-wrap justify-center gap-4 my-12">
              <a
                href="/"
                class="px-8 py-4 bg-[var(--color-luxury-gold)] text-[var(--color-luxury-charcoal)] uppercase tracking-widest font-bold text-sm hover:brightness-110 transition-all inline-block"
              >
                Download Master Brochure & Floor Plans
              </a>
              <a
                href="tel:+917744009295"
                class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white uppercase tracking-widest font-bold text-sm rounded-none border border-white/20 transition-all flex items-center gap-2"
              >
                <span>Connect with Sales Desk: +91-7744009295</span>
              </a>
            </div>
          </div>
        ) : (
          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-[var(--color-luxury-pearl)] prose-a:text-[var(--color-luxury-gold)]">
            <div set:html={data.content || ''} />
            
            <div class="mt-16 pt-8 border-t border-white/10 flex justify-center">
              <a
                href="/"
                class="px-8 py-4 bg-[var(--color-luxury-gold)] text-[var(--color-luxury-charcoal)] uppercase tracking-widest font-bold text-sm inline-block"
              >
                View Residences
              </a>
            </div>
          </div>
        )}
      </div>

      {!isArticle && <AeoFaqBlock keyword={data.h1} client:visible />}

      <InternalLinkingGrid currentSlug={slugKey} client:visible />

    </div>
  </div>
</BaseLayout>
