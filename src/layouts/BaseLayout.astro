  ogImage = "https://www.krahejacorpvistas.com/assets/og-image.jpg",
  schemas = []
} = Astro.props;

const DOMAIN = "https://www.krahejacorpvistas.com";
const fullCanonical = canonical.startsWith('http') ? canonical : `${DOMAIN}${canonical}`;

